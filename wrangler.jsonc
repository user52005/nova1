{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6f50769f-8cc4-4262-aa63-07e741da2de6","database_name": "nova-9c6383-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bd96b8795d3e4a498d9e99acea45a54c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
